{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://training.gen-em.org/schemas/exercise.json",
  "title": "content_json einer Übung im Katalog (AP-16, docs/konzept/uebungskatalog.md 4.3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kurz",
    "ziel",
    "ausfuehrung",
    "quellen"
  ],
  "properties": {
    "kurz": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "ein Satz, was die Übung ist; erscheint in find_exercise"
    },
    "ziel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "Zweck / Zielmuskulatur in Worten"
    },
    "muskeln": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      }
    },
    "voraussetzung": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500,
      "description": "Ausrüstung im Detail, Aufbau, Platz"
    },
    "ausfuehrung": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "achten": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "fehler": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "vorsicht": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "description": "Gegenanzeigen, Schmerzbezug mit Reha-Regel und Schmerzgrenze (R-UEB-13)"
    },
    "progression": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "regression": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "dosierung_hinweis": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300,
      "description": "Standardbereiche, keine Vorgabe je Einheit"
    },
    "links": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "titel",
          "art",
          "embed",
          "geprueft_am",
          "status"
        ],
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^https://[^\\s/?#]+\\.[^\\s/?#]+([/?#]\\S*)?$",
            "description": "nur https (E-10)"
          },
          "titel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "art": {
            "enum": [
              "text",
              "video"
            ]
          },
          "embed": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "pattern": "^https://(www\\.youtube-nocookie\\.com/embed/[A-Za-z0-9_-]{11}|player\\.vimeo\\.com/video/[0-9]+)$",
            "description": "vom Server gesetzt (E-04)"
          },
          "geprueft_am": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "vom Server gesetzt (E-10)"
          },
          "status": {
            "enum": [
              "ok",
              "defekt",
              "ungeprueft"
            ],
            "description": "vom Server gesetzt (E-10)"
          }
        }
      },
      "allOf": [
        {
          "not": {
            "contains": {
              "type": "object",
              "properties": {
                "art": {
                  "const": "text"
                }
              },
              "required": [
                "art"
              ]
            },
            "minContains": 3
          }
        },
        {
          "not": {
            "contains": {
              "type": "object",
              "properties": {
                "art": {
                  "const": "video"
                }
              },
              "required": [
                "art"
              ]
            },
            "minContains": 3
          }
        }
      ],
      "description": "höchstens 2 Text- und 2 Videolinks (E-11)"
    },
    "quellen": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "description": "L-…, R-…, D-… oder \"Einschätzung\"; mindestens 1 (E-06)"
    },
    "notizen": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    }
  }
}
