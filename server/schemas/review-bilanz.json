{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://training.gen-em.org/schemas/review-bilanz.json",
  "title": "content_json einer Blockbilanz (AP-15, docs/konzept/blockbilanz.md 4.3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zeitraum",
    "ziele",
    "gelungen",
    "nicht_gelungen",
    "empfehlung"
  ],
  "properties": {
    "zeitraum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "von",
        "bis"
      ],
      "properties": {
        "von": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "bis": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "ziele": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ziel_id",
          "ziel",
          "soll",
          "ist",
          "bewertung",
          "grund"
        ],
        "properties": {
          "ziel_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^z-\\d{1,3}$"
          },
          "ziel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "soll": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "ist": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "bewertung": {
            "enum": [
              "erreicht",
              "teilweise",
              "nicht",
              "nicht_bewertbar"
            ]
          },
          "grund": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "start": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "ende": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "datum": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "bewertung": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      }
    },
    "gelungen": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "nicht_gelungen": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "annahmen_geaendert": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "was",
          "neu",
          "begruendung",
          "vorschlag_trainerregel"
        ],
        "properties": {
          "was": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "neu": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "begruendung": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "vorschlag_trainerregel": {
            "type": "boolean"
          }
        }
      }
    },
    "empfehlung": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "offene_fragen": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  }
}
