{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://training.gen-em.org/schemas/review-zielklaerung.json",
  "title": "content_json einer Zielklärung (AP-15, docs/konzept/blockbilanz.md 4.3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ausgangslage",
    "phase",
    "phase_text",
    "prioritaeten",
    "ziele",
    "entscheidungen",
    "risiken",
    "block"
  ],
  "properties": {
    "ausgangslage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zeitbudget"
      ],
      "properties": {
        "zeitbudget": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "umstaende": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "einschraenkungen": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "ausruestung": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    },
    "phase": {
      "enum": [
        "reha",
        "grundlagen",
        "aufbau",
        "spezifisch",
        "wettkampf",
        "erhalt",
        "uebergang"
      ]
    },
    "phase_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "prioritaeten": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t1",
        "t2",
        "t3"
      ],
      "properties": {
        "t1": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "t2": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "t3": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        }
      }
    },
    "ziele": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "bereich",
          "ziel",
          "messgroesse",
          "kriterium"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^z-\\d{1,3}$",
            "description": "z-1, z-2 …; die Bilanz verweist darauf"
          },
          "bereich": {
            "enum": [
              "t1",
              "t2",
              "t3",
              "reha",
              "allgemein"
            ]
          },
          "ziel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "messgroesse": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "kriterium": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "termin": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "zielevents": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "datum"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "datum": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "art": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      }
    },
    "entscheidungen": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "thema",
          "entscheidung",
          "rationale",
          "verworfen"
        ],
        "properties": {
          "thema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "entscheidung": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "verworfen": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "description": "verworfene Alternativen mit Grund; mindestens ein Eintrag, sonst „keine“ (R-UEB-02)"
          },
          "quelle": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      }
    },
    "risiken": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risiko",
          "regel"
        ],
        "properties": {
          "risiko": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "regel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dauer_wochen"
      ],
      "properties": {
        "dauer_wochen": {
          "type": "integer",
          "minimum": 1,
          "maximum": 26
        },
        "phasen": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "wochen",
              "fokus"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "wochen": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "fokus": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        },
        "tests_start": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "offene_fragen": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  }
}
