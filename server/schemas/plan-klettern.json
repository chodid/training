{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://training.gen-em.org/schemas/plan-klettern.json",
  "title": "plan_json klettern (Konzept 7.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blocks"
  ],
  "properties": {
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "hangboard",
              "campus",
              "bouldern_volumen",
              "bouldern_limit",
              "ausdauer_route",
              "technik",
              "zugkraft",
              "antagonisten"
            ]
          },
          "exercise_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 3,
            "maxLength": 60,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Slug einer Übung im Katalog (AP-16, E-05/E-08); nur bei kind hangboard, campus, zugkraft, antagonisten"
          },
          "spezifitaet": {
            "enum": [
              "spezifisch",
              "halbspezifisch",
              "unspezifisch",
              null
            ]
          },
          "edge_mm": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 4,
            "maximum": 60
          },
          "grip": {
            "enum": [
              "halbkrimp",
              "offen",
              "vollkrimp",
              "zange",
              null
            ]
          },
          "hang_s": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 120
          },
          "rest_s": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 900
          },
          "sets": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 30
          },
          "added_load_kg": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -80,
            "maximum": 80,
            "description": "negativ = Entlastung"
          },
          "duration_min": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 300
          },
          "target": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        },
        "if": {
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "bouldern_volumen",
                "bouldern_limit",
                "ausdauer_route",
                "technik"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "exercise_id": {
              "type": "null",
              "description": "Einheitenformat ohne Katalogeintrag (E-05)"
            }
          }
        }
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    }
  }
}