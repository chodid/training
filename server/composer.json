{
    "name": "chodid/training-server",
    "description": "KI-Personal-Trainer: Webseite, Datenbank, MCP-Endpunkt",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-zlib": "*",
        "logiscape/mcp-sdk-php": "^2.0",
        "opis/json-schema": "^2.4",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Training\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Training\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
