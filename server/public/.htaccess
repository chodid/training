AddType application/manifest+json .webmanifest
AddType image/x-icon .ico

# App-Icons und Favicon (AP-13, E-09): ein neues Motiv bekommt neue Dateinamen, daher 7 Tage im Browser-Cache
<IfModule mod_headers.c>
    <FilesMatch "^(favicon\.ico|favicon\.svg|lama-[0-9a-z-]+\.png|apple-touch-icon-[0-9]+\.png)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS erzwingen
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Authorization-Header an PHP durchreichen (Bearer-Token, AP-01)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Alle Anfragen ohne passende Datei gehen an index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
