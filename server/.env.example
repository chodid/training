# Vorlage für die Konfiguration auf dem Server.
# Die echte Datei heißt ".env" und liegt im Subdomain-Ordner neben public/ (nie im Repo, nie im Docroot).
# Format: SCHLUESSEL=wert, eine Zeile pro Eintrag, "#" leitet Kommentare ein.

APP_ENV=production
APP_URL=https://training.gen-em.org

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Mindestens 32 Zeichen, identisch mit dem GitHub-Secret MIGRATION_SECRET.
# Erzeugen z. B. mit: openssl rand -hex 32
MIGRATION_SECRET=

# OAuth (AP-01, D-32): Signaturschlüssel der Access-Tokens (JWT HS256). Pflicht, mindestens 32 Zeichen;
# fehlt er oder ist er kürzer, startet die App nicht (Health meldet config fehlt).
# Wechsel des Werts macht alle ausgegebenen Access-Tokens sofort ungültig (Notbremse).
# Erzeugen z. B. mit: openssl rand -hex 32
OAUTH_JWT_SECRET=

# Statisches Fallback-Token für Claude Desktop / Claude Code (D-06). Wird nur akzeptiert,
# wenn MCP_STATIC_TOKEN_ENABLED=true gesetzt ist (Standard: aus). Mindestens 32 Zeichen empfohlen.
MCP_STATIC_TOKEN=
MCP_STATIC_TOKEN_ENABLED=false

# Intervals.icu (AP-02, Konzept Abschnitt 9). Optional, bis die Anbindung genutzt wird; /health meldet den Stand.
# API-Key: Intervals.icu → Einstellungen → Developer Settings. Athleten-ID steht dort und in der URL (z. B. i12345).
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# Backup (AP-10, D-18). Pflicht, mindestens 16 Zeichen: Passwort, mit dem alle Backups verschlüsselt werden
# (Download, E-Mail, vor Migrationen). Ohne diesen Wert findet keine Migration statt. Sicher aufbewahren –
# ohne das Passwort ist kein Backup lesbar. Erzeugen z. B. mit: openssl rand -base64 24
BACKUP_PASSWORD=

# Zeitgesteuerte Aufrufe (Lima-City-Cronjobs), Schlüssel mindestens 32 Zeichen:
#   täglich:   https://training.gen-em.org/cron/backup-mail?key=<CRON_SECRET>
#              (versendet nur, wenn seit dem letzten Versand BACKUP_MAIL_INTERVAL_DAYS vergangen sind)
#   stündlich: https://training.gen-em.org/cron/intervals-sync?key=<CRON_SECRET>
#              (Spiegel Intervals.icu → MySQL, letzte 14 Tage; einmalig &tage=365 für die Vorgeschichte;
#               gleicht außerdem den Kalender ab, wenn CALDAV_* gesetzt ist)
CRON_SECRET=
BACKUP_MAIL_TO=
BACKUP_MAIL_INTERVAL_DAYS=7

# Kalender per CalDAV (AP-11, D-50). Optional; ohne diese Werte ist die Funktion aus.
# CALDAV_URL: Adresse des Kalenders (nur https), bei Nextcloud: Kalender → „…“ am Kalender → „Link kopieren“ bzw.
#   https://<nextcloud>/remote.php/dav/calendars/<benutzer>/<kalender>/ – am besten einen eigenen Kalender „Training“ anlegen.
# CALDAV_PASSWORD: Nextcloud-App-Passwort (Einstellungen → Sicherheit → „Neues App-Passwort erstellen“), nicht das Login-Passwort.
CALDAV_URL=
CALDAV_USER=
CALDAV_PASSWORD=

# SMTP-Zugang des Mailkontos bei Lima-City (für Backup per E-Mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
